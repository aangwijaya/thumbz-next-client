{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/matches",
        "http://localhost:3000/videos",
        "http://localhost:3000/tournaments",
        "http://localhost:3000/search?q=onic"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "skipAudits": [
          "uses-http2"
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 307200
              }
            ],
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 2500
              }
            ],
            "total-blocking-time": [
              "warn",
              {
                "maxNumericValue": 200
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^((?!/search).)*$",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        }
      ]
    }
  }
}
