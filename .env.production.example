# Production env for Vercel (Project → Settings → Environment Variables → Production).
# NEXT_PUBLIC_* values are inlined at build time, so set them BEFORE deploying.
# Never put server-only secrets here (no service-role key, no client secret).

NEXT_PUBLIC_API_URL=https://<railway-service-domain>/api/v1

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-publishable-key>
