# API base URL (contract §1, §11.1) — never hardcode hosts
# Local NestJS backend default port: 3001 (see thumbz-server/.env)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Supabase (public keys only; never commit service-role credentials)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: shared secret for POST /api/revalidate, called by the API after
# writes. Must equal REVALIDATE_SECRET on the API. Empty disables the endpoint.
REVALIDATE_SECRET=
